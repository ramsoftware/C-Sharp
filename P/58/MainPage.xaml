<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ejemplo.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" >

            <Button Text="Anterior" Clicked="BtnAnterior_Clicked"/>

            <CollectionView x:Name="ListaColores">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="80,*,80">
                            <Label Text="{Binding Codigo}" />
                            <Label Grid.Column="1" Text="{Binding Nombre}" />
                            <Button Grid.Column="2" Text="Borrar" Margin="0,5"  Clicked="Eliminar_Clicked" CommandParameter="{Binding Codigo}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <Button Text="Siguiente"  Clicked="BtnSiguiente_Clicked"/>
            <Button Text="Nuevo Color" BackgroundColor="Green" Clicked="NuevoColor_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
